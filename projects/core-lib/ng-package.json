{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/core-lib",
  "lib": {
    "entryFile": "public-api.ts"
  },
  "assets": [
    {
      "input": "forms/validation",
      "glob": "LICENCE",
      "output": "forms/validation"
    },
    {
      "input": "node",
      "glob": "{LICENCE,package.json}",
      "output": "node"
    },
    {
      "input": "i18n",
      "glob": "LICENCE",
      "output": "i18n"
    },
    {
      "input": "ui/contact-details",
      "glob": "LICENCE",
      "output": "ui/contact-details"
    },
    {
      "input": "ui/loading-spinner",
      "glob": "LICENCE",
      "output": "ui/loading-spinner"
    },
    {
      "input": "case/models",
      "glob": "LICENCE",
      "output": "case/models"
    },
    {
      "input": "case/reference",
      "glob": "LICENCE",
      "output": "case/reference"
    },
    {
      "input": "case/sharing",
      "glob": "LICENCE",
      "output": "case/sharing"
    }
  ],
  "allowedNonPeerDependencies": [
    "dexie",
    "luxon",
    "axios"
  ]
}
