{
  "version": 1,
  "projects": {
    "test-host": {
      "projectType": "application",
      "root": "apps/test-host",
      "sourceRoot": "apps/test-host",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/test-host/main.ts",
            "index": "apps/test-host/index.html",
            "tsConfig": "apps/test-host/tsconfig.app.json",
            "outputPath": "dist/test-host",
            "styles": [],
            "polyfills": [
              "zone.js"
            ],
            "preserveSymlinks": true
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "test-host:build:development",
            "host": "127.0.0.1",
            "port": 4307,
            "proxyConfig": "apps/test-host/local-translations.mjs",
            "prebundle": {
              "exclude": [
                "@hmcts/rpx-xui-core-lib"
              ]
            }
          }
        }
      }
    },
    "translation-tests": {
      "projectType": "application",
      "root": "tests/i18n",
      "sourceRoot": "tests/i18n",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tests/i18n/main.ts",
            "index": "tests/i18n/index.html",
            "tsConfig": "tests/i18n/tsconfig.json",
            "outputPath": "dist/i18n-tests",
            "styles": [],
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "assets": [
              {
                "glob": "{jasmine.js,jasmine-html.js,boot0.js}",
                "input": "node_modules/jasmine-core/lib/jasmine-core",
                "output": "/"
              }
            ],
            "optimization": false,
            "sourceMap": true,
            "outputHashing": "none"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "translation-tests:build",
            "host": "127.0.0.1",
            "port": 4314,
            "prebundle": false
          }
        }
      }
    },
    "editor-tests": {
      "projectType": "application",
      "root": "tests/editor",
      "sourceRoot": "tests/editor",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tests/editor/main.ts",
            "index": "tests/editor/index.html",
            "tsConfig": "tests/editor/tsconfig.json",
            "outputPath": "dist/editor-tests",
            "styles": [],
            "polyfills": [
              "reflect-metadata",
              "zone.js",
              "zone.js/testing"
            ],
            "assets": [
              {
                "glob": "{jasmine.js,jasmine-html.js,boot0.js}",
                "input": "node_modules/jasmine-core/lib/jasmine-core",
                "output": "/"
              }
            ],
            "optimization": false,
            "sourceMap": true,
            "outputHashing": "none",
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/core-lib/case/editor-source/lib",
                "node_modules"
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "editor-tests:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
