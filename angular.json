{
  "version": 1,
  "projects": {
    "test-host": {
      "projectType": "application",
      "root": "apps/test-host",
      "sourceRoot": "apps/test-host",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/test-host/main.ts",
            "index": "apps/test-host/index.html",
            "tsConfig": "apps/test-host/tsconfig.app.json",
            "outputPath": "dist/test-host",
            "styles": [
              "node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.css"
            ],
            "polyfills": [
              "zone.js"
            ],
            "preserveSymlinks": true,
            "assets": [
              {
                "glob": "**/*",
                "input": "node_modules/govuk-frontend/dist/govuk/assets",
                "output": "assets"
              }
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "test-host:build:development",
            "host": "127.0.0.1",
            "port": 4307,
            "proxyConfig": "apps/test-host/local-translations.mjs",
            "prebundle": {
              "exclude": [
                "@hmcts/rpx-xui-core-lib"
              ]
            }
          }
        }
      }
    },
    "translation-tests": {
      "projectType": "application",
      "root": "tests/i18n",
      "sourceRoot": "tests/i18n",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tests/i18n/main.ts",
            "index": "tests/i18n/index.html",
            "tsConfig": "tests/i18n/tsconfig.host.json",
            "outputPath": "dist/i18n-tests",
            "styles": [],
            "polyfills": [],
            "assets": [],
            "optimization": false,
            "sourceMap": true,
            "outputHashing": "none"
          },
          "configurations": {
            "zoneless": {
              "polyfills": []
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "translation-tests:build",
            "host": "127.0.0.1",
            "port": 4314,
            "prebundle": false
          }
        },
        "vitest": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "translation-tests:build:zoneless",
            "tsConfig": "tests/i18n/tsconfig.vitest.json",
            "runner": "vitest",
            "browsers": [
              "ChromiumHeadless"
            ],
            "include": [
              "**/*.spec.ts"
            ],
            "providersFile": "tests/vitest-zoneless.providers.ts",
            "setupFiles": [
              "tests/vitest-setup.ts"
            ],
            "reporters": [
              "default",
              "./tests/reporters/vitest-evidence-reporter.mjs"
            ]
          }
        }
      }
    },
    "editor-tests": {
      "projectType": "application",
      "root": "tests/editor",
      "sourceRoot": "tests/editor",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tests/editor/main.ts",
            "index": "tests/editor/index.html",
            "tsConfig": "tests/editor/tsconfig.host.json",
            "outputPath": "dist/editor-tests",
            "aot": false,
            "styles": [],
            "polyfills": [
              "reflect-metadata"
            ],
            "assets": [],
            "optimization": false,
            "sourceMap": true,
            "outputHashing": "none",
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/core-lib/case/editor-source/lib",
                "node_modules"
              ]
            }
          },
          "configurations": {
            "zoneless": {
              "polyfills": [
                "reflect-metadata"
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "editor-tests:build"
          }
        },
        "vitest": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "editor-tests:build:zoneless",
            "tsConfig": "tests/editor/tsconfig.vitest.json",
            "runner": "vitest",
            "browsers": [
              "ChromiumHeadless"
            ],
            "include": [
              "**/*.spec.ts",
              "../../projects/core-lib/case/editor-source/**/*.spec.ts"
            ],
            "providersFile": "tests/vitest-zoneless.providers.ts",
            "setupFiles": [
              "tests/vitest-setup.ts"
            ],
            "reporters": [
              "default",
              "./tests/reporters/vitest-evidence-reporter.mjs"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
